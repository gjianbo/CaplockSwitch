// ---------------------------------------------------------------------------
// CapsSwitch.rc - 资源脚本
//
// 只做两件事：把两个托盘图标和一份 manifest 嵌进 exe。
// 路径相对于本文件所在目录（src/）。
// ---------------------------------------------------------------------------

#include "resource.h"

// ---- 图标 -----------------------------------------------------------------
IDI_CAPSSWITCH_ON   ICON    "../icons/IDI_ON.ico"
IDI_CAPSSWITCH_OFF  ICON    "../icons/IDI_OFF.ico"

// ---- 应用程序清单 ---------------------------------------------------------
// 1  = CREATEPROCESS_MANIFEST_RESOURCE_ID
// 24 = RT_MANIFEST
1                   24      "CapsSwitch.manifest"
